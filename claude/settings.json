{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark",
  "model": "opus[1m]",
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "includeCoAuthoredBy": false,
  "statusLine": {
    "type": "command",
    "command": "npx -y @owloops/claude-powerline@latest --style=powerline --theme=custom --config=$HOME/.claude/claude-powerline.json"
  }
}
